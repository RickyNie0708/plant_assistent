<!-- pages/index/index.wxml -->
<view class="page-container">
  <!-- 自定义导航栏 -->
  <view class="custom-navbar">
    <view class="nav-title">
      <text class="title-main">种下小美好</text>
      <text class="title-sub">{{currentDate}}</text>
    </view>
    <view class="weather-info" bindtap="onWeatherTap">
      <text class="weather-icon">{{weatherInfo.icon}}</text>
      <text class="weather-text">{{weatherInfo.text}}</text>
    </view>
  </view>

  <!-- 艺术轮播图 -->
  <swiper 
    class="art-swiper" 
    autoplay="true" 
    interval="4000" 
    circular="true" 
    indicator-dots="true"
    indicator-color="rgba(255,255,255,0.4)"
    indicator-active-color="#9370DB"
  >
    <block wx:for="{{swiperList}}" wx:key="id" wx:for-index="index">
      <swiper-item>
        <view 
          class="swiper-item" 
          style="background: {{item.bgColor}}"
          bindtap="onSwiperTap"
          data-index="{{index}}"
        >
          <text class="swiper-title">{{item.title}}</text>
          <text class="swiper-desc">{{item.desc}}</text>
          <view class="swiper-btn" style="position: relative; left: -9rpx; top: -22rpx">
            <text class="btn-text">立即探索 →</text>
          </view>
        </view>
      </swiper-item>
    </block>
  </swiper>

  <!-- 功能卡片区 -->
  <view class="function-section">
    <text class="section-title">我的植物生活</text>
    <text class="section-subtitle">在这里，遇见更好的自己</text>
    
    <view class="function-grid">
      <!-- 第一行 -->
      <view class="function-row">
        <view 
          class="function-card large-card"
          bindtap="onCardTap"
          data-page="calendar"
          data-id="1"
        >
          <view class="card-icon large-icon" style="background: linear-gradient(135deg, #667eea, #764ba2)">
            <text class="icon-text">📅</text>
          </view>
          <text class="card-title">时光手账</text>
          <text class="card-desc">记录每一刻的生长</text>
        </view>
        
        <view 
          class="function-card small-card"
          bindtap="onCardTap"
          data-page="record"
          data-id="2"
        >
          <view class="card-icon" style="background: linear-gradient(135deg, #f093fb, #f5576c)">
            <text class="icon-text">🌱</text>
          </view>
          <text class="card-title">成长印记</text>
        </view>
      </view>
      
      <!-- 第二行 -->
      <view class="function-row">
        <view 
          class="function-card small-card"
          bindtap="onCardTap"
          data-page="community"
          data-id="3"
        >
          <view class="card-icon" style="background: linear-gradient(135deg, #4facfe, #00f2fe)">
            <text class="icon-text">👥</text>
          </view>
          <text class="card-title">绿意社区</text>
        </view>
        
        <view 
          class="function-card large-card"
          bindtap="onCardTap"
          data-page="plantdb"
          data-id="4"
        >
          <view class="card-icon large-icon" style="background: linear-gradient(135deg, #43e97b, #38f9d7)">
            <text class="icon-text">📚</text>
          </view>
          <text class="card-title">植物百科</text>
          <text class="card-desc">了解每一株生命</text>
        </view>
      </view>
      
      <!-- 第三行 -->
      <view class="function-row">
        <view 
          class="function-card full-card"
          bindtap="onCardTap"
          data-page="assistant"
          data-id="5"
        >
          <view class="card-icon" style="background: linear-gradient(135deg, #fa709a, #fee140)">
            <text class="icon-text">✨</text>
          </view>
          <view class="card-content">
            <text class="card-title">智能助手</text>
            <text class="card-desc">解答你的养护困惑</text>
          </view>
          <text class="card-arrow">→</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 诗意提示 -->
  <view class="poetic-tip" bindtap="onTipTap">
    <text class="tip-icon">💭</text>
    <text class="tip-text">{{currentTip}}</text>
  </view>

  <!-- 动态花瓣 -->
  <view class="petal-container">
    <view class="petal" wx:for="{{6}}" wx:key="index" style="animation-delay: {{index * 0.5}}s"></view>
  </view>
</view>