/* pages/index/index.wxss */

/* 页面基础样式 */
.page-container {
  min-height: 100vh;
  background: linear-gradient(180deg, #FAF8F5 0%, #FFF9F5 100%);
  padding-bottom: 120rpx;
  position: relative;
  overflow: hidden;
}

/* 自定义导航栏 */
.custom-navbar {
  padding: 80rpx 40rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: flex-start;
  position: relative;
  z-index: 10;
}

.nav-title {
  display: flex;
  flex-direction: column;
}

.title-main {
  font-size: 44rpx;
  font-weight: 700;
  color: #2C3E50;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  letter-spacing: 2rpx;
  margin-bottom: 8rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.title-sub {
  font-size: 24rpx;
  color: #7F8C8D;
  font-weight: 300;
  letter-spacing: 1rpx;
  font-family: 'PingFang SC Light', 'Microsoft YaHei', sans-serif;
}

.weather-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 12rpx 24rpx;
  background: rgba(255, 255, 255, 0.9);
  border-radius: 40rpx;
  backdrop-filter: blur(10rpx);
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.weather-icon {
  font-size: 36rpx;
  margin-bottom: 4rpx;
}

.weather-text {
  font-size: 22rpx;
  color: #667eea;
  font-weight: 500;
}

/* 艺术轮播图 */
.art-swiper {
  height: 360rpx;
  margin: 0 40rpx 60rpx;
  border-radius: 24rpx;
  overflow: hidden;
  box-shadow: 0 20rpx 60rpx rgba(102, 126, 234, 0.15);
}

.swiper-item {
  height: 100%;
  padding: 60rpx 40rpx;
  display: flex;
  flex-direction: column;
  justify-content: center;
  position: relative;
  overflow: hidden;
}

.swiper-item::before {
  content: '';
  position: absolute;
  top: -50%;
  right: -50%;
  width: 100%;
  height: 200%;
  background: radial-gradient(circle, rgba(255,255,255,0.1) 1px, transparent 1px);
  background-size: 40rpx 40rpx;
  opacity: 0.5;
}

.swiper-title {
  font-size: 48rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 16rpx;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
  text-shadow: 0 4rpx 8rpx rgba(0, 0, 0, 0.1);
  letter-spacing: 2rpx;
}

.swiper-desc {
  font-size: 28rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 40rpx;
  font-weight: 300;
  line-height: 1.6;
}

.swiper-btn {
  align-self: flex-start;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
  color: white;
  font-size: 26rpx;
  padding: 16rpx 32rpx;
  border-radius: 50rpx;
  font-weight: 500;
  transition: all 0.3s ease;
}

.swiper-btn:active {
  background: rgba(255, 255, 255, 0.3);
  transform: scale(0.95);
}

/* 功能卡片区 */
.function-section {
  padding: 0 40rpx;
}

.section-title {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 8rpx;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.section-subtitle {
  display: block;
  font-size: 24rpx;
  color: #95A5A6;
  margin-bottom: 50rpx;
  font-weight: 300;
}

.function-grid {
  display: flex;
  flex-direction: column;
  gap: 30rpx;
}

.function-row {
  display: flex;
  gap: 30rpx;
}

/* 卡片基础样式 */
.function-card {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx 30rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
  position: relative;
  overflow: hidden;
}

.function-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, var(--gradient-color-1), var(--gradient-color-2));
}

.function-card:active {
  transform: translateY(-8rpx);
  box-shadow: 0 20rpx 60rpx rgba(0, 0, 0, 0.1);
}

/* 不同尺寸卡片 */
.large-card {
  flex: 2;
}

.small-card {
  flex: 1;
}

.full-card {
  width: 100%;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
}

/* 图标样式 */
.card-icon {
  width: 100rpx;
  height: 100rpx;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 24rpx;
  box-shadow: 0 12rpx 24rpx rgba(0, 0, 0, 0.15);
  transition: all 0.3s ease;
}

.large-icon {
  width: 120rpx;
  height: 120rpx;
}

.function-card:active .card-icon {
  transform: scale(1.1) rotate(5deg);
}

.icon-text {
  font-size: 48rpx;
}

.large-icon .icon-text {
  font-size: 56rpx;
}

/* 文字样式 */
.card-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 8rpx;
  font-family: 'PingFang SC', 'Microsoft YaHei', sans-serif;
}

.card-desc {
  font-size: 24rpx;
  color: #7F8C8D;
  font-weight: 300;
  text-align: center;
  line-height: 1.4;
}

.full-card .card-content {
  flex: 1;
  margin-left: 30rpx;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.full-card .card-desc {
  text-align: left;
}

.card-arrow {
  font-size: 36rpx;
  color: #667eea;
  font-weight: 300;
  opacity: 0.7;
  transition: all 0.3s ease;
}

.full-card:active .card-arrow {
  transform: translateX(10rpx);
  opacity: 1;
}

/* 诗意提示 */
.poetic-tip {
  margin: 60rpx 40rpx 0;
  padding: 32rpx;
  background: linear-gradient(135deg, rgba(255, 245, 235, 0.8), rgba(255, 240, 230, 0.6));
  border-radius: 20rpx;
  backdrop-filter: blur(10rpx);
  display: flex;
  align-items: center;
  border: 1rpx solid rgba(255, 182, 193, 0.2);
}

.tip-icon {
  font-size: 36rpx;
  margin-right: 20rpx;
  animation: float 3s ease-in-out infinite;
}

.tip-text {
  font-size: 26rpx;
  color: #E67E22;
  font-weight: 400;
  font-style: italic;
  line-height: 1.5;
  flex: 1;
}

/* 动态花瓣 */
.petal-container {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  pointer-events: none;
  z-index: 1;
}

.petal {
  position: absolute;
  top: -50rpx;
  width: 30rpx;
  height: 30rpx;
  background: linear-gradient(135deg, #667eea, #764ba2);
  opacity: 0.3;
  border-radius: 50%;
  animation: fall 15s linear infinite;
}

.petal:nth-child(odd) {
  background: linear-gradient(135deg, #f093fb, #f5576c);
}

.petal:nth-child(3n) {
  background: linear-gradient(135deg, #4facfe, #00f2fe);
}

/* 动画定义 */
@keyframes float {
  0%, 100% {
    transform: translateY(0);
  }
  50% {
    transform: translateY(-10rpx);
  }
}

@keyframes fall {
  0% {
    transform: translateY(-100rpx) rotate(0deg);
    opacity: 0;
  }
  10% {
    opacity: 0.3;
  }
  90% {
    opacity: 0.3;
  }
  100% {
    transform: translateY(calc(100vh + 100rpx)) rotate(360deg);
    opacity: 0;
  }
}

/* 微交互效果 */
.function-card:hover {
  cursor: pointer;
}

/* 响应式适配 */
@media (max-width: 375px) {
  .art-swiper {
    height: 320rpx;
    margin: 0 30rpx 50rpx;
  }
  
  .swiper-title {
    font-size: 40rpx;
  }
  
  .card-icon {
    width: 80rpx;
    height: 80rpx;
  }
  
  .icon-text {
    font-size: 40rpx;
  }
}