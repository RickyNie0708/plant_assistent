/* pages/assistant/assistant.wxss */

/* 页面整体样式 - 优雅渐变背景 */
.assistant-page {
  min-height: 100vh;
  background: linear-gradient(165deg, 
    #faf5ff 0%,      /* 淡紫色 */
    #f0f9ff 30%,     /* 淡绿色 */
    #f8fafc 100%     /* 中性灰 */
  );
  padding: 0;
  box-sizing: border-box;
  font-family: -apple-system, BlinkMacSystemFont, 'SF Pro Display', 'Helvetica Neue', Arial, sans-serif;
}

/* 顶部导航栏 - 毛玻璃效果 */
.header {
  height: 100rpx;
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  display: flex;
  align-items: center;
  padding: 0 28rpx;
  border-bottom: 1rpx solid rgba(120, 86, 255, 0.08);
  position: relative;
  z-index: 1000;
}

.back-btn {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  color: #6d28d9;
  font-size: 28rpx;
  font-weight: 500;
  transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
}

.back-btn .icon {
  font-size: 36rpx;
  margin-right: 10rpx;
  font-weight: 300;
}

.back-btn:active {
  opacity: 0.7;
  transform: translateX(-4rpx);
}

.title {
  flex: 1;
  text-align: center;
  font-size: 36rpx;
  font-weight: 700;
  color: #1e293b;
  letter-spacing: -0.8rpx;
  background: linear-gradient(135deg, #8b5cf6 0%, #10b981 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.clear-btn {
  width: 68rpx;
  height: 68rpx;
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b5cf6;
  font-size: 28rpx;
  background: rgba(139, 92, 246, 0.08);
  border: 1rpx solid rgba(139, 92, 246, 0.15);
  transition: all 0.3s ease;
}

.clear-btn:active {
  background: rgba(139, 92, 246, 0.15);
  transform: scale(0.95);
}

/* 对话区域 */
.chat-container {
  height: calc(100vh - 380rpx);
  padding: 32rpx 28rpx 200rpx;
  box-sizing: border-box;
  position: relative;
}

.chat-container::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 100%;
  background: 
    radial-gradient(circle at 20% 80%, rgba(139, 92, 246, 0.03) 0%, transparent 50%),
    radial-gradient(circle at 80% 20%, rgba(16, 185, 129, 0.03) 0%, transparent 50%);
  pointer-events: none;
}

.chat-messages {
  display: flex;
  flex-direction: column;
  gap: 40rpx;
  padding-bottom: 40rpx;
}

/* 消息入场动画 */
@keyframes messageEntrance {
  0% {
    opacity: 0;
    transform: translateY(24rpx) scale(0.98);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

.message {
  display: flex;
  animation: messageEntrance 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 头像设计 */
.message-avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 22rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-top: 4rpx;
  position: relative;
  overflow: hidden;
}

.message-avatar::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.2) 0%, 
    rgba(255, 255, 255, 0) 100%
  );
  border-radius: 22rpx;
}

.ai-message .message-avatar {
  background: linear-gradient(135deg, #8b5cf6 0%, #7c3aed 100%);
  box-shadow: 
    0 8rpx 24rpx rgba(139, 92, 246, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
}

.user-message .message-avatar {
  background: linear-gradient(135deg, #10b981 0%, #059669 100%);
  box-shadow: 
    0 8rpx 24rpx rgba(16, 185, 129, 0.25),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
}

.avatar-icon {
  font-size: 34rpx;
  color: white;
  font-weight: 600;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

/* AI消息样式 */
.ai-message {
  flex-direction: row;
}

.ai-message .message-content {
  margin-left: 24rpx;
  margin-right: 80rpx;
  max-width: 580rpx;
}

.ai-message .message-text {
  background: linear-gradient(145deg, 
    rgba(255, 255, 255, 0.95) 0%,
    rgba(248, 250, 252, 0.95) 100%
  );
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: 28rpx 28rpx 28rpx 8rpx;
  padding: 32rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: #334155;
  box-shadow: 
    0 12rpx 32rpx rgba(139, 92, 246, 0.1),
    0 4rpx 8rpx rgba(139, 92, 246, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(139, 92, 246, 0.15);
  position: relative;
  overflow: hidden;
  white-space: pre-line;
}

.ai-message .message-text::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #8b5cf6 0%, #a78bfa 100%);
  border-radius: 28rpx 28rpx 0 0;
}

.ai-message .message-actions {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 20rpx;
  padding: 0 12rpx;
}

/* 用户消息样式 */
.user-message {
  flex-direction: row-reverse;
}

.user-message .message-content {
  margin-right: 24rpx;
  margin-left: 80rpx;
  max-width: 580rpx;
  text-align: right;
}

.user-message .message-text {
  background: linear-gradient(145deg, 
    rgba(16, 185, 129, 0.95) 0%,
    rgba(5, 150, 105, 0.95) 100%
  );
  backdrop-filter: blur(10rpx);
  -webkit-backdrop-filter: blur(10rpx);
  border-radius: 28rpx 28rpx 8rpx 28rpx;
  padding: 32rpx;
  font-size: 32rpx;
  line-height: 1.6;
  color: white;
  box-shadow: 
    0 12rpx 32rpx rgba(16, 185, 129, 0.2),
    0 4rpx 8rpx rgba(16, 185, 129, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
  border: 1rpx solid rgba(255, 255, 255, 0.1);
  position: relative;
  overflow: hidden;
}

.user-message .message-text::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #10b981 0%, #34d399 100%);
  border-radius: 28rpx 28rpx 0 0;
}

.user-message .message-time {
  margin-top: 16rpx;
  padding-right: 12rpx;
}

/* 时间样式 */
.time {
  font-size: 24rpx;
  color: #94a3b8;
  font-weight: 400;
  letter-spacing: 0.5rpx;
}

.user-message .time {
  color: rgba(255, 255, 255, 0.8);
}

/* 复制按钮样式 */
.copy-btn {
  display: flex;
  align-items: center;
  gap: 12rpx;
  padding: 12rpx 20rpx;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.9) 0%,
    rgba(248, 250, 252, 0.9) 100%
  );
  border-radius: 18rpx;
  font-size: 25rpx;
  color: #64748b;
  font-weight: 500;
  transition: all 0.3s ease;
  border: 1rpx solid rgba(139, 92, 246, 0.1);
  box-shadow: 
    0 4rpx 12rpx rgba(139, 92, 246, 0.05),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.copy-btn:active {
  background: rgba(255, 255, 255, 0.8);
  transform: translateY(2rpx);
  box-shadow: 0 2rpx 6rpx rgba(139, 92, 246, 0.08);
}

.copy-btn .icon {
  font-size: 24rpx;
  opacity: 0.8;
}

/* AI思考中样式 */
.thinking {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 28rpx 32rpx;
  background: linear-gradient(145deg, 
    rgba(255, 255, 255, 0.9) 0%,
    rgba(248, 250, 252, 0.9) 100%
  );
  backdrop-filter: blur(10rpx);
  border-radius: 28rpx;
  border: 1rpx solid rgba(139, 92, 246, 0.1);
  box-shadow: 
    0 8rpx 24rpx rgba(139, 92, 246, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.thinking text {
  font-size: 30rpx;
  color: #8b5cf6;
  font-weight: 500;
  letter-spacing: 1rpx;
}

.thinking-dots {
  display: flex;
  gap: 8rpx;
}

.thinking-dot {
  width: 12rpx;
  height: 12rpx;
  border-radius: 50%;
  background: linear-gradient(135deg, #8b5cf6, #a78bfa);
  animation: thinkingPulse 1.5s ease-in-out infinite;
}

.thinking-dot:nth-child(2) {
  animation-delay: 0.2s;
}

.thinking-dot:nth-child(3) {
  animation-delay: 0.4s;
}

@keyframes thinkingPulse {
  0%, 100% {
    opacity: 0.3;
    transform: translateY(0);
  }
  50% {
    opacity: 1;
    transform: translateY(-8rpx);
  }
}

/* 快速提问区域 - 渐变卡片 */
.quick-questions {
  position: fixed;
  bottom: 200rpx;
  left: 0;
  right: 0;
  padding: 0 28rpx;
  z-index: 100;
}

.quick-card {
  background: linear-gradient(145deg, 
    rgba(255, 255, 255, 0.9) 0%,
    rgba(248, 250, 252, 0.9) 100%
  );
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-radius: 28rpx;
  padding: 32rpx;
  box-shadow: 
    0 16rpx 40rpx rgba(139, 92, 246, 0.12),
    0 4rpx 12rpx rgba(139, 92, 246, 0.06),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
  border: 1rpx solid rgba(139, 92, 246, 0.15);
  position: relative;
  overflow: hidden;
}

.quick-card::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  height: 4rpx;
  background: linear-gradient(90deg, #8b5cf6 0%, #10b981 100%);
}

.section-title {
  font-size: 30rpx;
  font-weight: 700;
  color: #1e293b;
  margin-bottom: 28rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  letter-spacing: 0.5rpx;
}

.section-title::before {
  content: '✦';
  font-size: 28rpx;
  background: linear-gradient(135deg, #8b5cf6, #10b981);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.question-tags {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.tag {
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.9) 0%,
    rgba(248, 250, 252, 0.9) 100%
  );
  border: 1rpx solid rgba(139, 92, 246, 0.1);
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #475569;
  display: flex;
  align-items: center;
  gap: 16rpx;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  cursor: pointer;
  position: relative;
  overflow: hidden;
}

.tag::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(139, 92, 246, 0.05) 0%,
    rgba(16, 185, 129, 0.05) 100%
  );
  opacity: 0;
  transition: opacity 0.3s ease;
}

.tag:active {
  transform: translateY(-4rpx) scale(1.02);
  box-shadow: 
    0 12rpx 24rpx rgba(139, 92, 246, 0.15),
    0 4rpx 8rpx rgba(139, 92, 246, 0.08);
  border-color: rgba(139, 92, 246, 0.2);
}

.tag:active::before {
  opacity: 1;
}

.tag .emoji {
  font-size: 32rpx;
  flex-shrink: 0;
  filter: drop-shadow(0 4rpx 8rpx rgba(0, 0, 0, 0.1));
}

.tag .text {
  flex: 1;
  font-weight: 500;
  line-height: 1.4;
}

/* 输入区域 - 渐变悬浮设计 */
.input-area {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  height: 200rpx;
  background: linear-gradient(to top, 
    rgba(255, 255, 255, 0.98) 0%,
    rgba(250, 245, 255, 0.95) 100%
  );
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 1rpx solid rgba(139, 92, 246, 0.1);
  padding: 32rpx 28rpx;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  gap: 20rpx;
  z-index: 1000;
}

.input-wrapper {
  flex: 1;
  position: relative;
}

.input-field {
  width: 100%;
  height: 88rpx;
  background: linear-gradient(145deg, 
    rgba(255, 255, 255, 0.9) 0%,
    rgba(248, 250, 252, 0.9) 100%
  );
  backdrop-filter: blur(10rpx);
  border-radius: 24rpx;
  padding: 0 40rpx 0 32rpx;
  font-size: 32rpx;
  color: #1e293b;
  border: 1rpx solid rgba(139, 92, 246, 0.15);
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 
    0 8rpx 24rpx rgba(139, 92, 246, 0.08),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.input-field:focus {
  outline: none;
  border-color: rgba(139, 92, 246, 0.3);
  box-shadow: 
    0 12rpx 32rpx rgba(139, 92, 246, 0.15),
    0 0 0 4rpx rgba(139, 92, 246, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.6);
}

.input-field::placeholder {
  color: #94a3b8;
  font-size: 30rpx;
  font-weight: 400;
}

.quick-send {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 56rpx;
  height: 56rpx;
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.1), rgba(16, 185, 129, 0.1));
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8b5cf6;
  font-size: 28rpx;
  font-weight: 300;
  transition: all 0.3s ease;
  opacity: 0.6;
}

.quick-send:active {
  background: linear-gradient(135deg, rgba(139, 92, 246, 0.2), rgba(16, 185, 129, 0.2));
  opacity: 1;
  transform: translateY(-50%) scale(0.95);
}

.send-btn {
  width: 88rpx;
  height: 88rpx;
  border-radius: 24rpx;
  background: linear-gradient(135deg, 
    #8b5cf6 0%, 
    #7c3aed 50%,
    #10b981 100%
  );
  display: flex;
  align-items: center;
  justify-content: center;
  border: none;
  padding: 0;
  margin: 0;
  transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
  box-shadow: 
    0 12rpx 32rpx rgba(139, 92, 246, 0.3),
    0 4rpx 8rpx rgba(139, 92, 246, 0.15),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
  position: relative;
  overflow: hidden;
}

.send-btn::before {
  content: '';
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: linear-gradient(135deg, 
    rgba(255, 255, 255, 0.1) 0%,
    rgba(255, 255, 255, 0) 100%
  );
}

.send-btn:active {
  transform: translateY(4rpx) scale(0.96);
  box-shadow: 
    0 4rpx 16rpx rgba(139, 92, 246, 0.25),
    0 2rpx 4rpx rgba(139, 92, 246, 0.1),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
}

.send-btn:disabled {
  background: linear-gradient(135deg, #cbd5e1, #94a3b8);
  box-shadow: 
    0 4rpx 12rpx rgba(148, 163, 184, 0.2),
    inset 0 1rpx 0 rgba(255, 255, 255, 0.2);
}

.send-btn .icon {
  font-size: 36rpx;
  color: white;
  font-weight: 300;
  text-shadow: 0 2rpx 4rpx rgba(0, 0, 0, 0.1);
}

.send-btn:disabled .icon {
  color: #e2e8f0;
}

/* 底部提示 */
.footer-tips {
  position: fixed;
  bottom: 200rpx;
  left: 0;
  right: 0;
  padding: 20rpx 28rpx;
  background: linear-gradient(135deg, 
    rgba(139, 92, 246, 0.05) 0%,
    rgba(16, 185, 129, 0.05) 100%
  );
  backdrop-filter: blur(20rpx);
  z-index: 90;
  border-top: 1rpx solid rgba(139, 92, 246, 0.1);
  border-bottom: 1rpx solid rgba(139, 92, 246, 0.1);
}

.footer-tips text {
  font-size: 24rpx;
  color: #64748b;
  display: block;
  text-align: center;
  line-height: 1.5;
  font-weight: 400;
  letter-spacing: 0.5rpx;
  opacity: 0.8;
}

/* 自定义滚动条 */
::-webkit-scrollbar {
  width: 6rpx;
}

::-webkit-scrollbar-track {
  background: rgba(139, 92, 246, 0.05);
  border-radius: 3rpx;
}

::-webkit-scrollbar-thumb {
  background: linear-gradient(135deg, #8b5cf6, #10b981);
  border-radius: 3rpx;
  transition: all 0.3s ease;
}

::-webkit-scrollbar-thumb:hover {
  opacity: 0.8;
}

/* 响应式优化 */
@media (max-width: 320px) {
  .header,
  .chat-container,
  .quick-questions,
  .input-area {
    padding: 0 24rpx;
  }
  
  .quick-card {
    padding: 28rpx 24rpx;
  }
  
  .message-text {
    padding: 28rpx;
    font-size: 30rpx;
  }
}

/* 优雅的加载骨架动画 */
@keyframes shimmer {
  0% {
    background-position: -468rpx 0;
  }
  100% {
    background-position: 468rpx 0;
  }
}