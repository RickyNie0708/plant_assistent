<!-- pages/record/addRecord.wxml -->
<view class="add-record-page">
  <!-- 头部 -->
  <view class="page-header">
    <button class="back-btn" bindtap="goBack">
      <text class="icon">←</text>
    </button>
    <text class="page-title">添加印记</text>
    <button class="save-btn" bindtap="saveRecord" disabled="{{!formValid}}">
      <text class="save-text">保存</text>
    </button>
  </view>

  <!-- 表单区域 -->
  <scroll-view class="form-container" scroll-y>
    <!-- 日期时间 -->
    <view class="form-section">
      <text class="section-label">时间印记</text>
      <view class="time-inputs">
        <picker 
          mode="date" 
          value="{{formData.date}}" 
          start="2020-01-01" 
          end="{{maxDate}}"
          bindchange="onDateChange"
        >
          <view class="date-picker">
            <text class="date-icon">📅</text>
            <text class="date-text">{{formData.date || '选择日期'}}</text>
            <text class="arrow">›</text>
          </view>
        </picker>
        
        <picker 
          mode="time" 
          value="{{formData.time}}" 
          bindchange="onTimeChange"
        >
          <view class="time-picker">
            <text class="time-icon">🕐</text>
            <text class="time-text">{{formData.time || '选择时间'}}</text>
            <text class="arrow">›</text>
          </view>
        </picker>
      </view>
    </view>

    <!-- 植物信息 -->
    <view class="form-section">
      <text class="section-label">植物伙伴</text>
      <input 
        class="plant-input" 
        type="text" 
        placeholder="输入植物名称" 
        value="{{formData.plantName}}"
        bindinput="onPlantNameChange"
        placeholder-class="placeholder"
      />
    </view>

    <!-- 养护类型 -->
    <view class="form-section">
      <text class="section-label">养护类型</text>
      <view class="type-grid">
        <view 
          wx:for="{{careTypes}}" 
          wx:key="id"
          class="type-item {{formData.type === item.id ? 'selected' : ''}}"
          bindtap="selectType"
          data-type="{{item.id}}"
        >
          <text class="type-icon">{{item.icon}}</text>
          <text class="type-label">{{item.label}}</text>
        </view>
      </view>
    </view>

    <!-- 详细描述 -->
    <view class="form-section">
      <text class="section-label">生长故事</text>
      <textarea 
        class="description-input" 
        placeholder="记录此刻的心情、发现或小观察..." 
        value="{{formData.description}}"
        bindinput="onDescriptionChange"
        placeholder-class="placeholder"
        maxlength="200"
        auto-height
      />
      <view class="char-count">
        <text class="count">{{(formData.description ? formData.description.length : 0)}}/200</text>
      </view>
    </view>

    <!-- 图片上传 -->
    <view class="form-section">
      <text class="section-label">美好瞬间</text>
      <view class="image-upload">
        <block wx:for="{{formData.images}}" wx:key="index">
          <view class="image-item">
            <image class="image" src="{{item}}" mode="aspectFill"></image>
            <button class="remove-btn" bindtap="removeImage" data-index="{{index}}">
              <text class="remove-icon">×</text>
            </button>
          </view>
        </block>
        
        <view 
          wx:if="{{formData.images.length < 9}}"
          class="upload-btn"
          bindtap="uploadImage"
        >
          <text class="upload-icon">+</text>
          <text class="upload-text">添加照片</text>
        </view>
      </view>
      <text class="upload-hint">最多可上传9张照片</text>
    </view>

    <!-- 位置信息 -->
    <view class="form-section">
      <view class="location-header">
        <text class="section-label">位置记录</text>
        <switch 
          checked="{{formData.recordLocation}}"
          bindchange="toggleLocation"
          color="#667eea"
        />
      </view>
      <view wx:if="{{formData.recordLocation}}" class="location-info">
        <text class="location-icon">📍</text>
        <text class="location-text">{{formData.location || '正在获取位置...'}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 诗意提示 -->
  <view wx:if="{{!formValid}}" class="validation-tip">
    <text class="tip-icon">✨</text>
    <text class="tip-text">请完善必填信息，为这一刻留下完整的印记</text>
  </view>
</view>