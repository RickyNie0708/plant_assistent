/* pages/record/detail.wxss */
.detail-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FAF8F5 0%, #F5F7FA 100%);
}

/* 头部 */
.page-header {
  padding: 80rpx 40rpx 40rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
  position: sticky;
  top: 0;
  z-index: 10;
}

.back-btn {
  width: 80rpx;
  height: 80rpx;
  border-radius: 50%;
  background: #f8f9fa;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
}

.back-btn .icon {
  font-size: 36rpx;
  color: #667eea;
}

.page-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #2C3E50;
  position: absolute;
  left: 50%;
  transform: translateX(-50%);
}

.header-actions {
  display: flex;
  gap: 16rpx;
}

.action-btn {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
}

.action-btn.share {
  background: rgba(79, 172, 254, 0.1);
}

.action-btn.edit {
  background: rgba(102, 126, 234, 0.1);
}

.action-btn:active {
  transform: scale(0.9);
}

.action-icon {
  font-size: 28rpx;
}

/* 内容容器 */
.content-container {
  height: calc(100vh - 220rpx);
  padding: 0 30rpx 40rpx;
}

/* 通用区块样式 */
.info-section,
.location-section,
.description-section,
.images-section,
.meta-section,
.action-section {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  margin-top: 30rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.06);
}

.section-title {
  display: block;
  font-size: 30rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 30rpx;
  padding-left: 8rpx;
  border-left: 6rpx solid #667eea;
}

/* 植物信息 */
.plant-name {
  display: block;
  font-size: 48rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 30rpx;
  line-height: 1.3;
}

.time-info {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
  flex-wrap: wrap;
}

.date-icon,
.time-icon {
  font-size: 32rpx;
}

.date,
.time {
  font-size: 28rpx;
  color: #95A5A6;
  margin-right: 30rpx;
}

/* 类型标签 */
.type-tag {
  display: inline-flex;
  align-items: center;
  padding: 12rpx 24rpx;
  border-radius: 30rpx;
  background: rgba(102, 126, 234, 0.1);
  color: #667eea;
  font-size: 26rpx;
  font-weight: 500;
}

.type-tag.watering {
  background: rgba(79, 172, 254, 0.1);
  color: #4facfe;
}

.type-tag.fertilizing {
  background: rgba(67, 233, 123, 0.1);
  color: #43e97b;
}

.type-tag.pruning {
  background: rgba(250, 112, 154, 0.1);
  color: #fa709a;
}

.type-tag.weeding {
  background: rgba(255, 209, 102, 0.1);
  color: #ffd166;
}

.type-tag.repotting {
  background: rgba(147, 112, 219, 0.1);
  color: #9370DB;
}

.type-icon {
  font-size: 28rpx;
  margin-right: 12rpx;
}

.type-text {
  font-size: 26rpx;
}

/* 位置信息 */
.location-content {
  display: flex;
  align-items: center;
  gap: 20rpx;
  padding: 24rpx;
  background: rgba(102, 126, 234, 0.05);
  border-radius: 16rpx;
  border: 1rpx solid rgba(102, 126, 234, 0.1);
}

.location-icon {
  font-size: 36rpx;
  color: #667eea;
}

.location-text {
  flex: 1;
  font-size: 28rpx;
  color: #667eea;
  line-height: 1.5;
}

/* 描述内容 */
.description-content {
  padding: 30rpx;
  background: #f8f9fa;
  border-radius: 16rpx;
}

.description-text {
  font-size: 30rpx;
  color: #34495E;
  line-height: 1.8;
}

/* 图片展示 */
.images-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
}

.image-item {
  width: 100%;
  height: 0;
  padding-bottom: 100%; /* 正方形 */
  border-radius: 16rpx;
  overflow: hidden;
  position: relative;
  box-shadow: 0 4rpx 20rpx rgba(0, 0, 0, 0.1);
}

.image {
  position: absolute;
  width: 100%;
  height: 100%;
  top: 0;
  left: 0;
}

/* 元信息 */
.meta-list {
  padding: 20rpx 0;
}

.meta-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 24rpx;
}

.meta-label {
  min-width: 160rpx;
  font-size: 26rpx;
  color: #95A5A6;
  font-weight: 500;
}

.meta-value {
  flex: 1;
  font-size: 26rpx;
  color: #2C3E50;
  line-height: 1.5;
}

.meta-value.id-text {
  font-size: 24rpx;
  color: #7F8C8D;
  word-break: break-all;
  font-family: monospace;
}

/* 操作按钮 */
.action-section {
  display: grid;
  grid-template-columns: 1fr 1fr;
  gap: 20rpx;
  padding: 40rpx;
}

.action-btn.large {
  height: 100rpx;
  border-radius: 20rpx;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  transition: all 0.3s ease;
  font-size: 28rpx;
  font-weight: 500;
}

.action-btn.large:active {
  transform: scale(0.98);
}

.edit-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
}

.delete-btn {
  background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
  color: white;
}

.btn-icon {
  font-size: 36rpx;
}

/* 空状态 */
.empty-state {
  padding: 120rpx 40rpx;
  text-align: center;
}

.empty-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 40rpx;
  opacity: 0.6;
}

.empty-text {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #95A5A6;
  margin-bottom: 60rpx;
}

.empty-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  padding: 24rpx 48rpx;
  border-radius: 50rpx;
  font-size: 28rpx;
  font-weight: 500;
  box-shadow: 0 8rpx 32rpx rgba(102, 126, 234, 0.3);
}

.empty-btn:active {
  transform: scale(0.95);
}