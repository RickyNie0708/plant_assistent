<!-- pages/record/record.wxml -->
<view class="record-page">
  <!-- 头部 -->
  <view class="page-header">
    <button class="back-btn" bindtap="goBack">
      <text class="icon">←</text>
    </button>
    <text class="page-title">成长印记</text>
    <button class="add-btn" bindtap="addNewRecord">
      <text class="add-icon">+</text>
    </button>
  </view>

  <!-- 搜索和筛选 -->
  <view class="filter-section">
    <input 
      class="search-input" 
      placeholder="搜索植物或记录..." 
      bindinput="onSearchInput"
      placeholder-class="placeholder"
    />
    <picker 
      class="filter-picker" 
      mode="selector" 
      range="{{filterOptions}}" 
      bindchange="onFilterChange"
    >
      <text class="filter-text">{{filterOptions[currentFilter] || '全部类型'}}</text>
      <text class="filter-icon">▼</text>
    </picker>
  </view>

  <!-- 记录列表 -->
  <scroll-view 
    class="record-list" 
    scroll-y 
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onPullDownRefresh"
  >
    <!-- 空状态 -->
    <view wx:if="{{records.length === 0}}" class="empty-state">
      <text class="empty-icon">🌱</text>
      <text class="empty-title">暂无养护记录</text>
      <text class="empty-tip">开始记录你的植物成长故事吧</text>
      <button class="empty-btn" bindtap="addNewRecord">
        添加第一条记录
      </button>
    </view>

    <!-- 记录卡片 -->
    <block wx:for="{{records}}" wx:key="_id" wx:for-index="index">
      <view class="record-card">
        <!-- 卡片内容区域 - 点击跳转到详情页 -->
        <view 
          class="card-content" 
          bindtap="viewRecord" 
          data-id="{{item._id}}" 
          data-index="{{index}}"
        >
          <!-- 植物信息 -->
          <view class="record-header">
            <text class="plant-name">{{item.plantName}}</text>
            <view class="type-tag {{item.type}}">
              <text class="type-icon">{{getTypeIcon(item.type)}}</text>
              <text class="type-text">{{getTypeText(item.type)}}</text>
            </view>
          </view>

          <!-- 时间信息 -->
          <view class="record-time">
            <text class="date">{{item.date}}</text>
            <text class="time">{{item.time}}</text>
          </view>

          <!-- 描述摘要 -->
          <view wx:if="{{item.description}}" class="record-desc">
            <text class="desc-text">{{item.description}}</text>
          </view>

          <!-- 图片预览 -->
          <view wx:if="{{item.images && item.images.length > 0}}" class="image-preview">
            <image 
              class="preview-img" 
              src="{{item.images[0]}}" 
              mode="aspectFill"
            />
            <text wx:if="{{item.images.length > 1}}" class="image-count">
              +{{item.images.length - 1}}
            </text>
          </view>
        </view>

        <!-- 操作按钮区域 - 使用catchtap阻止事件冒泡 -->
        <view class="record-actions">
          <button 
            class="action-btn edit" 
            catchtap="editRecord" 
            data-id="{{item._id}}"
            data-index="{{index}}"
          >
            <text class="btn-icon">✏️</text>
            <text class="btn-text">编辑</text>
          </button>
          <button 
            class="action-btn delete" 
            catchtap="deleteRecord" 
            data-id="{{item._id}}"
            data-index="{{index}}"
          >
            <text class="btn-icon">🗑️</text>
            <text class="btn-text">删除</text>
          </button>
        </view>
      </view>
    </block>
  </scroll-view>
</view>