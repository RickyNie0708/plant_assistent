/* pages/register/register.wxss */
.register-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #f8fff9 0%, #f0f9ff 100%);
  padding: 40rpx 32rpx;
  box-sizing: border-box;
}

/* 头部 */
.header {
  margin-bottom: 60rpx;
  position: relative;
}

.back-btn {
  position: absolute;
  top: 0;
  left: 0;
  width: 64rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
  color: #666;
}

.page-title {
  display: block;
  font-size: 44rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-top: 20rpx;
}

.page-subtitle {
  display: block;
  font-size: 28rpx;
  color: #666;
  text-align: center;
  margin-top: 12rpx;
}

/* 表单容器 */
.form-container {
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(20rpx);
  border-radius: 24rpx;
  padding: 40rpx 32rpx;
  box-shadow: 0 8rpx 32rpx rgba(0, 0, 0, 0.08);
}

/* 表单项 */
.form-item {
  border: 2rpx solid #e0e0e0;
  border-radius: 16rpx;
  padding: 0 28rpx;
  margin-bottom: 24rpx;
  height: 96rpx;
  display: flex;
  align-items: center;
  transition: all 0.3s ease;
  background: #fff;
}

.form-item.active {
  border-color: #07c160;
  box-shadow: 0 0 0 4rpx rgba(7, 193, 96, 0.1);
}

.form-label {
  width: 160rpx;
  display: flex;
  align-items: center;
  font-size: 30rpx;
  color: #333;
}

.form-label .icon {
  margin-right: 16rpx;
  font-size: 32rpx;
}

.form-input {
  flex: 1;
  height: 100%;
  font-size: 30rpx;
  color: #1a1a1a;
}

.placeholder {
  color: #999;
  font-size: 28rpx;
}

.input-status {
  width: 48rpx;
  height: 48rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}

.success {
  color: #07c160;
}

.error {
  color: #ff4444;
}

/* 输入提示 */
.input-tip {
  font-size: 24rpx;
  color: #999;
  margin: -16rpx 0 20rpx 180rpx;
}

/* 密码强度 */
.password-strength {
  display: flex;
  align-items: center;
  margin: -8rpx 0 24rpx 180rpx;
}

.strength-indicator {
  display: flex;
  gap: 8rpx;
  margin-right: 16rpx;
}

.strength-dot {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e0e0e0;
  transition: all 0.3s ease;
}

.strength-dot.active {
  background: #07c160;
}

.strength-text {
  font-size: 24rpx;
  color: #666;
}

/* 协议区域 */
.agreement-section {
  margin: 40rpx 0 48rpx;
}

.agreement-item {
  display: flex;
  align-items: flex-start;
}

.agreement-checkbox {
  width: 40rpx;
  height: 40rpx;
  border: 2rpx solid #ccc;
  border-radius: 8rpx;
  margin-right: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  transition: all 0.3s ease;
}

.agreement-checkbox.checked {
  background: #07c160;
  border-color: #07c160;
}

.agreement-checkbox .icon {
  color: white;
  font-size: 24rpx;
  font-weight: bold;
}

.agreement-text {
  flex: 1;
  font-size: 26rpx;
  color: #666;
  line-height: 1.6;
}

.link {
  color: #07c160;
}

/* 按钮 */
.submit-btn,
.guest-btn {
  width: 100%;
  height: 96rpx;
  border-radius: 48rpx;
  font-size: 32rpx;
  font-weight: 500;
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: all 0.3s ease;
  margin-bottom: 24rpx;
}

.submit-btn {
  background: #e0e0e0;
  color: #999;
}

.submit-btn.active {
  background: linear-gradient(135deg, #07c160, #0db371);
  color: white;
  box-shadow: 0 8rpx 24rpx rgba(7, 193, 96, 0.3);
}

.guest-btn {
  background: transparent;
  color: #07c160;
  border: 2rpx solid #07c160;
}

.btn-hover {
  opacity: 0.9;
  transform: translateY(-2rpx);
}

/* 分割线 */
.divider {
  display: flex;
  align-items: center;
  margin: 40rpx 0;
}

.divider-line {
  flex: 1;
  height: 1rpx;
  background: #e0e0e0;
}

.divider-text {
  margin: 0 32rpx;
  font-size: 26rpx;
  color: #999;
}

/* 登录链接 */
.login-link {
  text-align: center;
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #666;
}

.login-link .link {
  margin-left: 16rpx;
  font-weight: 500;
}

/* 底部 */
.footer {
  text-align: center;
  margin-top: 60rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.1);
}

.footer-text {
  font-size: 24rpx;
  color: #999;
}