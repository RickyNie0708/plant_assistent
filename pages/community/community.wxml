<!-- pages/community/community.wxml -->
<view class="community-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="nav-left">
      <text class="nav-title">绿意社区</text>
      <text class="nav-subtitle">与万千植物爱好者一起成长</text>
    </view>
    <button class="publish-btn" bindtap="goToPublish">
      <text class="publish-icon">+</text>
      <text class="publish-text">发布</text>
    </button>
  </view>

  <!-- 顶部标签页 -->
  <scroll-view class="tab-scroll" scroll-x>
    <view class="tab-container">
      <view 
        wx:for="{{tabs}}" 
        wx:key="id"
        class="tab-item {{activeTab === item.id ? 'active' : ''}}"
        bindtap="switchTab"
        data-id="{{item.id}}"
      >
        <text class="tab-text">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 搜索和筛选 -->
  <view class="filter-section">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input 
        class="search-input" 
        placeholder="搜索帖子或植物..." 
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="onSearchConfirm"
      />
    </view>
    <picker 
      class="sort-picker" 
      range="{{sortOptions}}" 
      bindchange="onSortChange"
    >
      <text class="sort-text">{{sortOptions[currentSort]}}</text>
      <text class="sort-icon">▼</text>
    </picker>
  </view>

  <!-- 社区内容 -->
  <scroll-view 
    class="content-scroll" 
    scroll-y 
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onPullDownRefresh"
    bindscrolltolower="onReachBottom"
  >
    <!-- 轮播图 -->
    <swiper 
      wx:if="{{activeTab === 'recommend'}}" 
      class="banner-swiper" 
      autoplay="true" 
      interval="4000"
      circular="true"
    >
      <block wx:for="{{banners}}" wx:key="id">
        <swiper-item>
          <view class="banner-item" style="background: {{item.bgColor}}">
            <text class="banner-title">{{item.title}}</text>
            <text class="banner-desc">{{item.desc}}</text>
          </view>
        </swiper-item>
      </block>
    </swiper>

    <!-- 今日话题 -->
    <view wx:if="{{activeTab === 'recommend'}}" class="daily-topic">
      <view class="topic-header">
        <text class="topic-title">🌿 今日话题</text>
        <text class="topic-more" bindtap="viewAllTopics">更多 ></text>
      </view>
      <view class="topic-content">
        <text class="topic-text">{{dailyTopic.title}}</text>
        <view class="topic-stats">
          <text class="stat-item">👥 {{dailyTopic.participants}}人参与</text>
          <text class="stat-item">💬 {{dailyTopic.comments}}条讨论</text>
        </view>
        <button class="join-btn" bindtap="joinTopic">参与讨论</button>
      </view>
    </view>

    <!-- 帖子列表 -->
    <view class="post-list">
      <block wx:for="{{posts}}" wx:key="id">
        <view class="post-card">
          <!-- 用户信息 -->
          <view class="user-info">
            <image class="user-avatar" src="{{item.user.avatar}}" mode="aspectFill"></image>
            <view class="user-detail">
              <text class="user-name">{{item.user.name}}</text>
              <text class="post-time">{{item.time}} · {{item.category}}</text>
            </view>
            <view class="user-actions">
              <button 
                class="follow-btn {{item.isFollowing ? 'followed' : ''}}" 
                bindtap="toggleFollow"
                data-id="{{item.user.id}}"
              >
                {{item.isFollowing ? '已关注' : '+ 关注'}}
              </button>
            </view>
          </view>

          <!-- 帖子内容 -->
          <view class="post-content" bindtap="viewPostDetail" data-id="{{item.id}}">
            <text class="post-title">{{item.title}}</text>
            <text class="post-text">{{item.content}}</text>
            
            <!-- 图片预览 -->
            <view wx:if="{{item.images.length > 0}}" class="post-images">
              <view class="images-grid">
                <block wx:for="{{item.images.slice(0, 4)}}" wx:key="index">
                  <view class="image-item" style="width: {{item.images.length === 1 ? '100%' : 'calc(50% - 5rpx)'}}">
                    <image class="image" src="{{item}}" mode="aspectFill"></image>
                    <text 
                      wx:if="{{index === 3 && item.images.length > 4}}" 
                      class="image-more"
                    >
                      +{{item.images.length - 4}}
                    </text>
                  </view>
                </block>
              </view>
            </view>

            <!-- 植物标签 -->
            <view wx:if="{{item.plants.length > 0}}" class="plant-tags">
              <block wx:for="{{item.plants}}" wx:key="name">
                <view class="plant-tag">
                  <text class="plant-icon">🌱</text>
                  <text class="plant-name">{{item}}</text>
                </view>
              </block>
            </view>
          </view>

          <!-- 互动操作 -->
          <view class="post-actions">
            <view class="action-item" bindtap="toggleLike" data-id="{{item.id}}">
              <text class="action-icon {{item.isLiked ? 'liked' : ''}}">
                {{item.isLiked ? '❤️' : '🤍'}}
              </text>
              <text class="action-count">{{item.likeCount}}</text>
            </view>
            
            <view class="action-item" bindtap="focusComment" data-id="{{item.id}}">
              <text class="action-icon">💬</text>
              <text class="action-count">{{item.commentCount}}</text>
            </view>
            
            <view class="action-item" bindtap="toggleCollect" data-id="{{item.id}}">
              <text class="action-icon {{item.isCollected ? 'collected' : ''}}">
                {{item.isCollected ? '⭐' : '☆'}}
              </text>
              <text class="action-count">{{item.collectCount}}</text>
            </view>
            
            <view class="action-item share-btn" bindtap="sharePost" data-id="{{item.id}}">
              <text class="action-icon">↗️</text>
              <text class="action-text">分享</text>
            </view>
          </view>

          <!-- 热门评论 -->
          <view wx:if="{{item.hotComments.length > 0}}" class="hot-comments">
            <block wx:for="{{item.hotComments}}" wx:key="id">
              <view class="comment-item">
                <text class="comment-user">{{item.user}}：</text>
                <text class="comment-text">{{item.content}}</text>
              </view>
            </block>
            <text class="view-all-comments" bindtap="viewPostDetail" data-id="{{item.id}}">
              查看全部{{item.commentCount}}条评论
            </text>
          </view>
        </view>
      </block>
    </view>

    <!-- 加载状态 -->
    <view wx:if="{{loading}}" class="loading-more">
      <text class="loading-text">加载中...</text>
    </view>

    <view wx:if="{{!hasMore && posts.length > 0}}" class="no-more">
      <text class="no-more-text">没有更多内容了</text>
    </view>

    <!-- 空状态 -->
    <view wx:if="{{posts.length === 0 && !loading}}" class="empty-state">
      <text class="empty-icon">👥</text>
      <text class="empty-title">暂无内容</text>
      <text class="empty-tip">
        {{activeTab === 'follow' ? '你还没有关注任何人，快去发现有趣的植友吧！' : '这里还没有帖子，快来发布第一条吧！'}}
      </text>
      <button class="empty-btn" bindtap="goToPublish">
        发布第一条帖子
      </button>
    </view>
  </scroll-view>

  <!-- 发布按钮 -->
  <view class="fab-container">
    <button class="fab-btn" bindtap="goToPublish">
      <text class="fab-icon">✏️</text>
    </button>
  </view>

  <!-- 底部评论输入框 -->
  <view wx:if="{{showCommentInput}}" class="comment-input-wrapper">
    <view class="comment-input-container">
      <input 
        class="comment-input" 
        placeholder="写下你的评论..." 
        focus="{{true}}"
        bindinput="onCommentInput"
        value="{{commentText}}"
        confirm-type="send"
        bindconfirm="submitComment"
      />
      <button class="send-btn" bindtap="submitComment">
        <text class="send-text">发送</text>
      </button>
      <button class="cancel-btn" bindtap="hideCommentInput">
        <text class="cancel-text">取消</text>
      </button>
    </view>
  </view>
</view>