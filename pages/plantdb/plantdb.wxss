/* pages/plantdb/plantdb.wxss */
.plantdb-page {
  min-height: 100vh;
  background: linear-gradient(180deg, #FAF8F5 0%, #F5F7FA 100%);
  padding-bottom: 100rpx;
  box-sizing: border-box;
}

/* 自定义导航栏 */
.custom-nav {
  padding: 80rpx 30rpx 30rpx;
  display: flex;
  justify-content: space-between;
  align-items: center;
  background: white;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.nav-left {
  flex: 1;
}

.nav-title {
  display: block;
  font-size: 40rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 6rpx;
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.nav-subtitle {
  display: block;
  font-size: 22rpx;
  color: #95A5A6;
  font-weight: 300;
  letter-spacing: 1rpx;
}

.scan-btn {
  width: 120rpx;
  height: 56rpx;
  border-radius: 28rpx;
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  border: none;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 6rpx;
  box-shadow: 0 6rpx 20rpx rgba(67, 233, 123, 0.3);
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.scan-btn:active {
  transform: scale(0.95);
}

.scan-icon {
  font-size: 22rpx;
  color: white;
}

.scan-text {
  font-size: 24rpx;
  color: white;
  font-weight: 500;
}

/* 搜索栏 */
.search-section {
  padding: 20rpx 30rpx;
  background: white;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.search-box {
  background: #f8f9fa;
  border-radius: 50rpx;
  padding: 0 30rpx;
  display: flex;
  align-items: center;
  gap: 16rpx;
  height: 80rpx;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.05);
}

.search-icon {
  font-size: 28rpx;
  color: #95A5A6;
}

.search-input {
  flex: 1;
  height: 100%;
  font-size: 26rpx;
  color: #2C3E50;
}

/* 分类标签 */
.category-scroll {
  background: white;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.category-container {
  display: flex;
  padding: 20rpx 30rpx;
  height: 100rpx;
  align-items: center;
}

.category-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 24rpx;
  margin-right: 30rpx;
  transition: all 0.3s ease;
  flex-shrink: 0;
}

.category-item.active .category-icon {
  transform: scale(1.1);
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  color: white;
}

.category-item.active .category-name {
  color: #43e97b;
  font-weight: 600;
}

.category-icon {
  width: 60rpx;
  height: 60rpx;
  border-radius: 50%;
  background: #f8f9fa;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  margin-bottom: 8rpx;
  transition: all 0.3s ease;
}

.category-name {
  font-size: 22rpx;
  color: #95A5A6;
  font-weight: 500;
  white-space: nowrap;
}

/* 热门推荐轮播 */
.hot-swiper {
  height: 280rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin: 24rpx 30rpx;
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

.hot-item {
  width: 100%;
  height: 100%;
  position: relative;
}

.hot-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.hot-overlay {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  background: linear-gradient(transparent, rgba(0, 0, 0, 0.7));
  padding: 40rpx 30rpx 30rpx;
  color: white;
}

.hot-title {
  display: block;
  font-size: 36rpx;
  font-weight: 700;
  color: white;
  margin-bottom: 8rpx;
  text-shadow: 0 2rpx 6rpx rgba(0, 0, 0, 0.3);
}

.hot-desc {
  display: block;
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
  margin-bottom: 20rpx;
  font-style: italic;
}

.hot-tag {
  display: inline-flex;
  align-items: center;
  padding: 8rpx 20rpx;
  background: rgba(255, 255, 255, 0.2);
  backdrop-filter: blur(10rpx);
  border-radius: 20rpx;
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.tag-icon {
  font-size: 20rpx;
  margin-right: 8rpx;
}

.tag-text {
  font-size: 22rpx;
  color: white;
  font-weight: 500;
}

/* 植物列表 */
.plant-list-scroll {
  height: calc(100vh - 520rpx);
  padding: 0 24rpx 30rpx;
  box-sizing: border-box;
}

/* 植物卡片网格 */
.plant-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 20rpx;
  margin-top: 20rpx;
}

.plant-card {
  background: white;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
  transition: all 0.3s ease;
}

.plant-card:active {
  transform: translateY(-2rpx);
  box-shadow: 0 8rpx 30rpx rgba(0, 0, 0, 0.1);
}

/* 植物图片容器 */
.plant-image-container {
  position: relative;
  width: 100%;
  height: 200rpx;
}

.plant-image {
  width: 100%;
  height: 100%;
  object-fit: cover;
}

.plant-difficulty {
  position: absolute;
  top: 16rpx;
  left: 16rpx;
  padding: 6rpx 16rpx;
  border-radius: 16rpx;
  font-size: 20rpx;
  font-weight: 500;
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(255, 255, 255, 0.3);
}

.plant-difficulty.easy {
  background: rgba(67, 233, 123, 0.2);
  color: #43e97b;
}

.plant-difficulty.medium {
  background: rgba(255, 193, 7, 0.2);
  color: #FFC107;
}

.plant-difficulty.hard {
  background: rgba(244, 67, 54, 0.2);
  color: #F44336;
}

.difficulty-text {
  font-size: 20rpx;
  font-weight: 600;
}

.favorite-btn {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.9);
  backdrop-filter: blur(10rpx);
  border: 1rpx solid rgba(0, 0, 0, 0.1);
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 0;
  transition: all 0.3s ease;
}

.favorite-btn.active {
  background: rgba(255, 193, 7, 0.9);
}

.favorite-btn:active {
  transform: scale(0.9);
}

.favorite-icon {
  font-size: 22rpx;
  color: #333;
}

.favorite-btn.active .favorite-icon {
  color: white;
}

/* 植物信息 */
.plant-info {
  padding: 20rpx;
}

.plant-name {
  display: block;
  font-size: 28rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 4rpx;
  line-height: 1.3;
}

.plant-scientific {
  display: block;
  font-size: 20rpx;
  color: #95A5A6;
  font-style: italic;
  margin-bottom: 16rpx;
}

/* 植物特性 */
.plant-features {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid rgba(0, 0, 0, 0.05);
}

.feature-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  flex: 1;
}

.feature-icon {
  font-size: 24rpx;
  margin-bottom: 6rpx;
  opacity: 0.8;
}

.feature-text {
  font-size: 18rpx;
  color: #95A5A6;
  text-align: center;
  line-height: 1.2;
}

/* 养护要点 */
.care-tips {
  display: flex;
  align-items: flex-start;
  gap: 10rpx;
}

.tip-icon {
  font-size: 20rpx;
  color: #FFC107;
  flex-shrink: 0;
  margin-top: 2rpx;
}

.tip-text {
  font-size: 20rpx;
  color: #666;
  line-height: 1.4;
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
  text-overflow: ellipsis;
}

/* 空状态 */
.empty-state {
  padding: 120rpx 40rpx;
  text-align: center;
  background: white;
  border-radius: 20rpx;
  margin-top: 40rpx;
  box-shadow: 0 6rpx 24rpx rgba(0, 0, 0, 0.06);
}

.empty-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 32rpx;
  opacity: 0.6;
}

.empty-title {
  display: block;
  font-size: 32rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 16rpx;
}

.empty-tip {
  display: block;
  font-size: 26rpx;
  color: #95A5A6;
  line-height: 1.4;
}

/* 加载状态 */
.loading-more, .no-more {
  padding: 60rpx 0;
  text-align: center;
}

.loading-text, .no-more-text {
  font-size: 26rpx;
  color: #95A5A6;
}

/* 底部筛选栏 */
.filter-bar {
  position: fixed;
  bottom: 0;
  left: 0;
  right: 0;
  background: white;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
  display: flex;
  padding: 20rpx 30rpx;
  box-shadow: 0 -4rpx 20rpx rgba(0, 0, 0, 0.05);
  z-index: 100;
}

.filter-item {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 10rpx;
  padding: 16rpx;
  background: #f8f9fa;
  border-radius: 12rpx;
  margin: 0 10rpx;
  transition: all 0.3s ease;
}

.filter-item:active {
  background: #e9ecef;
}

.filter-text {
  font-size: 24rpx;
  color: #2C3E50;
  font-weight: 500;
}

.filter-icon {
  font-size: 20rpx;
  color: #95A5A6;
}