<!-- pages/plantdb/plantdb.wxml -->
<view class="plantdb-page">
  <!-- 自定义导航栏 -->
  <view class="custom-nav">
    <view class="nav-left">
      <text class="nav-title">植物百科</text>
      <text class="nav-subtitle">认识每一株生命的奥秘</text>
    </view>
    <button class="scan-btn" bindtap="scanPlant">
      <text class="scan-icon">📷</text>
      <text class="scan-text">识图</text>
    </button>
  </view>

  <!-- 搜索栏 -->
  <view class="search-section">
    <view class="search-box">
      <text class="search-icon">🔍</text>
      <input 
        class="search-input" 
        placeholder="搜索植物名称..." 
        bindinput="onSearchInput"
        confirm-type="search"
        bindconfirm="onSearchConfirm"
      />
    </view>
  </view>

  <!-- 分类标签 -->
  <scroll-view class="category-scroll" scroll-x>
    <view class="category-container">
      <view 
        wx:for="{{categories}}"
        wx:key="id"
        class="category-item {{activeCategory === item.id ? 'active' : ''}}"
        bindtap="switchCategory"
        data-id="{{item.id}}"
      >
        <text class="category-icon">{{item.icon}}</text>
        <text class="category-name">{{item.name}}</text>
      </view>
    </view>
  </scroll-view>

  <!-- 热门推荐轮播 -->
  <swiper 
    wx:if="{{activeCategory === 'all'}}"
    class="hot-swiper"
    autoplay="true"
    interval="4000"
    circular="true"
    indicator-dots="true"
    indicator-color="rgba(255,255,255,0.4)"
    indicator-active-color="#43e97b"
  >
    <block wx:for="{{hotPlants}}" wx:key="id">
      <swiper-item>
        <view 
          class="hot-item"
          bindtap="viewPlantDetail"
          data-id="{{item.id}}"
        >
          <image class="hot-image" src="{{item.image}}" mode="aspectFill"></image>
          <view class="hot-overlay">
            <text class="hot-title">{{item.name}}</text>
            <text class="hot-desc">{{item.scientificName}}</text>
            <view class="hot-tag">
              <text class="tag-icon">🌡️</text>
              <text class="tag-text">{{item.temperature}}</text>
            </view>
          </view>
        </view>
      </swiper-item>
    </block>
  </swiper>

  <!-- 植物列表 -->
  <scroll-view 
    class="plant-list-scroll"
    scroll-y
    refresher-enabled="{{true}}"
    refresher-triggered="{{refreshing}}"
    bindrefresherrefresh="onPullDownRefresh"
    bindscrolltolower="onReachBottom"
  >
    <!-- 空状态 -->
    <view wx:if="{{plants.length === 0 && !loading}}" class="empty-state">
      <text class="empty-icon">🌿</text>
      <text class="empty-title">暂无植物数据</text>
      <text class="empty-tip">请尝试其他分类或搜索关键词</text>
    </view>

    <!-- 植物卡片网格 -->
    <view class="plant-grid">
      <block wx:for="{{plants}}" wx:key="id">
        <view 
          class="plant-card"
          bindtap="viewPlantDetail"
          data-id="{{item.id}}"
        >
          <!-- 植物图片 -->
          <view class="plant-image-container">
            <image class="plant-image" src="{{item.image}}" mode="aspectFill"></image>
            <view class="plant-difficulty {{item.difficulty}}">
              <text class="difficulty-text">{{item.difficultyText}}</text>
            </view>
            <button 
              wx:if="{{!item.isFavorite}}"
              class="favorite-btn"
              bindtap="toggleFavorite"
              data-id="{{item.id}}"
              catchtap="stopPropagation"
            >
              <text class="favorite-icon">☆</text>
            </button>
            <button 
              wx:else
              class="favorite-btn active"
              bindtap="toggleFavorite"
              data-id="{{item.id}}"
              catchtap="stopPropagation"
            >
              <text class="favorite-icon">⭐</text>
            </button>
          </view>

          <!-- 植物信息 -->
          <view class="plant-info">
            <text class="plant-name">{{item.name}}</text>
            <text class="plant-scientific">{{item.scientificName}}</text>
            
            <!-- 植物特性 -->
            <view class="plant-features">
              <view class="feature-item">
                <text class="feature-icon">💧</text>
                <text class="feature-text">{{item.waterNeed}}</text>
              </view>
              <view class="feature-item">
                <text class="feature-icon">☀️</text>
                <text class="feature-text">{{item.lightNeed}}</text>
              </view>
              <view class="feature-item">
                <text class="feature-icon">🌡️</text>
                <text class="feature-text">{{item.temperature}}</text>
              </view>
            </view>

            <!-- 养护要点 -->
            <view class="care-tips">
              <text class="tip-icon">✨</text>
              <text class="tip-text">{{item.careTip}}</text>
            </view>
          </view>
        </view>
      </block>
    </view>

    <!-- 加载状态 -->
    <view wx:if="{{loading}}" class="loading-more">
      <text class="loading-text">加载中...</text>
    </view>

    <view wx:if="{{!hasMore && plants.length > 0}}" class="no-more">
      <text class="no-more-text">没有更多植物了</text>
    </view>
  </scroll-view>

  <!-- 底部筛选栏 -->
  <view class="filter-bar">
    <picker 
      class="filter-item"
      range="{{filterOptions}}"
      bindchange="onFilterChange"
    >
      <text class="filter-text">{{filterOptions[currentFilter]}}</text>
      <text class="filter-icon">▼</text>
    </picker>
    
    <view 
      class="filter-item"
      bindtap="toggleViewMode"
    >
      <text class="filter-icon">{{viewMode === 'grid' ? '☰' : '⏹️'}}</text>
      <text class="filter-text">{{viewMode === 'grid' ? '列表' : '网格'}}</text>
    </view>
  </view>
</view>