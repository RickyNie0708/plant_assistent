<!-- pages/login/login.wxml -->
<view class="login-page">
  <!-- 背景装饰 -->
  <view class="bg-decoration">
    <view class="circle circle-1"></view>
    <view class="circle circle-2"></view>
    <view class="circle circle-3"></view>
  </view>

  <!-- 登录容器 -->
  <view class="login-container">
    <!-- Logo和标题 -->
    <view class="header">
      <text class="app-name">种下小美好</text>
      <text class="welcome">{{loginTitle}}</text>
      <text class="subtitle">记录植物的每一次成长</text>
    </view>

    <!-- 登录方式切换 -->
    <view class="login-type-tabs">
      <view 
        class="tab-item {{currentTab === 0 ? 'active' : ''}}" 
        bindtap="switchTab" 
        data-index="0"
      >
        手机登录
      </view>
      <view 
        class="tab-item {{currentTab === 1 ? 'active' : ''}}" 
        bindtap="switchTab" 
        data-index="1"
      >
        用户名登录
      </view>
      <view 
        class="tab-item {{currentTab === 2 ? 'active' : ''}}" 
        bindtap="switchTab" 
        data-index="2"
      >
        注册
      </view>
    </view>

    <!-- 手机登录/注册表单 -->
    <view wx:if="{{currentTab === 0 || currentTab === 2}}" class="form-container">
      <!-- 手机号输入 -->
      <view class="input-group">
        <text class="input-label">手机号</text>
        <input 
          class="input-field" 
          type="number" 
          placeholder="请输入手机号" 
          maxlength="11"
          value="{{phone}}"
          bindinput="onPhoneInput"
          placeholder-class="placeholder"
        />
      </view>

      <!-- 验证码输入（注册时显示） -->
      <view wx:if="{{currentTab === 2}}" class="input-group">
        <text class="input-label">验证码</text>
        <view class="code-input-wrapper">
          <input 
            class="code-field" 
            type="number" 
            placeholder="请输入验证码" 
            maxlength="6"
            value="{{verificationCode}}"
            bindinput="onCodeInput"
            placeholder-class="placeholder"
          />
          <button 
            class="get-code-btn" 
            bindtap="getVerificationCode"
            disabled="{{countdown > 0 || !phoneValid}}"
          >
            {{countdown > 0 ? countdown + 's后重新获取' : '获取验证码'}}
          </button>
        </view>
      </view>

      <!-- 密码输入 -->
      <view class="input-group">
        <text class="input-label">{{currentTab === 2 ? '设置密码' : '密码'}}</text>
        <input 
          class="input-field" 
          password 
          placeholder="{{currentTab === 2 ? '请设置6-20位密码' : '请输入密码'}}" 
          value="{{password}}"
          bindinput="onPasswordInput"
          placeholder-class="placeholder"
          confirm-type="go"
          bindconfirm="{{currentTab === 2 ? 'onRegister' : 'onPhoneLogin'}}"
        />
      </view>

      <!-- 用户名输入（注册时显示） -->
      <view wx:if="{{currentTab === 2}}" class="input-group">
        <text class="input-label">用户名</text>
        <input 
          class="input-field" 
          placeholder="请设置用户名" 
          value="{{username}}"
          bindinput="onUsernameInput"
          placeholder-class="placeholder"
        />
      </view>

      <!-- 登录/注册按钮 -->
      <button 
        class="login-btn" 
        bindtap="{{currentTab === 2 ? 'onRegister' : 'onPhoneLogin'}}"
        disabled="{{!canSubmit}}"
        loading="{{loading}}"
      >
        {{currentTab === 2 ? (loading ? '注册中...' : '注册') : (loading ? '登录中...' : '登录')}}
      </button>
    </view>

    <!-- 用户名登录表单 -->
    <view wx:if="{{currentTab === 1}}" class="form-container">
      <!-- 用户名输入 -->
      <view class="input-group">
        <text class="input-label">用户名</text>
        <input 
          class="input-field" 
          placeholder="请输入用户名" 
          value="{{username}}"
          bindinput="onUsernameInput"
          placeholder-class="placeholder"
        />
      </view>

      <!-- 密码输入 -->
      <view class="input-group">
        <text class="input-label">密码</text>
        <input 
          class="input-field" 
          password 
          placeholder="请输入密码" 
          value="{{password}}"
          bindinput="onPasswordInput"
          placeholder-class="placeholder"
          confirm-type="go"
          bindconfirm="onUsernameLogin"
        />
      </view>

      <!-- 登录按钮 -->
      <button 
        class="login-btn" 
        bindtap="onUsernameLogin"
        disabled="{{!canSubmit}}"
        loading="{{loading}}"
      >
        {{loading ? '登录中...' : '登录'}}
      </button>
    </view>

    <!-- 快速登录（微信一键登录） -->
    <view class="quick-login">
      <text class="quick-title">快捷登录/注册</text>
      <view class="quick-buttons">
        <button 
          class="quick-btn wechat" 
          open-type="getUserProfile" 
          bindgetuserinfo="onWechatLogin"
        >
          <text class="quick-icon">💚</text>
          <text class="quick-text">微信一键登录</text>
        </button>
        <!-- 可以添加其他登录方式 -->
      </view>
    </view>

    <!-- 游客模式 -->
    <view class="guest-mode">
      <text class="guest-text" bindtap="enterAsGuest">先看看，稍后登录</text>
    </view>

    <!-- 底部装饰 -->
    <view class="bottom-decoration">
      <text class="plant-icon">🌱</text>
      <text class="plant-text">每一株植物都有它的故事</text>
    </view>
  </view>

  <!-- 加载遮罩 -->
  <view wx:if="{{loading}}" class="loading-mask">
    <view class="loading-content">
      <text class="loading-text">{{currentTab === 2 ? '注册中...' : '登录中...'}}</text>
    </view>
  </view>
</view>