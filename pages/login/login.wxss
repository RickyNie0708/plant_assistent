/* pages/login/login.wxss */
.login-page {
  min-height: 100vh;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  padding: 40rpx 0;
  position: relative;
  overflow: hidden;
}

/* 背景装饰 */
.bg-decoration {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 1;
}

.circle {
  position: absolute;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.1);
}

.circle-1 {
  width: 400rpx;
  height: 400rpx;
  top: -200rpx;
  right: -100rpx;
}

.circle-2 {
  width: 300rpx;
  height: 300rpx;
  bottom: -150rpx;
  left: -100rpx;
}

.circle-3 {
  width: 200rpx;
  height: 200rpx;
  top: 40%;
  left: -80rpx;
}

/* 登录容器 */
.login-container {
  position: relative;
  z-index: 2;
  background: white;
  border-radius: 32rpx;
  margin: 0 40rpx;
  padding: 40rpx 40rpx 60rpx;
  box-shadow: 0 20rpx 80rpx rgba(0, 0, 0, 0.2);
}

/* 头部 */
.header {
  text-align: center;
  margin-bottom: 50rpx;
}

.app-name {
  display: block;
  font-size: 56rpx;
  font-weight: 700;
  color: #2C3E50;
  margin-bottom: 16rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  -webkit-background-clip: text;
  -webkit-text-fill-color: transparent;
  background-clip: text;
}

.welcome {
  display: block;
  font-size: 36rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 8rpx;
}

.subtitle {
  display: block;
  font-size: 24rpx;
  color: #95A5A6;
  font-weight: 300;
}

/* 登录方式切换 */
.login-type-tabs {
  display: flex;
  justify-content: space-around;
  margin-bottom: 40rpx;
  border-bottom: 2rpx solid #f0f0f0;
}

.tab-item {
  padding: 20rpx 0;
  font-size: 28rpx;
  color: #95A5A6;
  font-weight: 500;
  position: relative;
  transition: color 0.3s ease;
}

.tab-item.active {
  color: #667eea;
  font-weight: 600;
}

.tab-item.active::after {
  content: '';
  position: absolute;
  bottom: -2rpx;
  left: 10%;
  right: 10%;
  height: 4rpx;
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  border-radius: 4rpx;
}

.tab-item:active {
  opacity: 0.7;
}

/* 表单容器 */
.form-container {
  margin-bottom: 50rpx;
}

/* 输入组 */
.input-group {
  margin-bottom: 40rpx;
  position: relative;
}

.input-label {
  display: block;
  font-size: 28rpx;
  font-weight: 600;
  color: #2C3E50;
  margin-bottom: 16rpx;
}

.input-field {
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 26rpx;
  font-size: 28rpx;
  color: #2C3E50;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.input-field:focus {
  border-color: #667eea;
  background: white;
}

.placeholder {
  color: #BDC3C7;
}

/* 验证码输入样式 */
.code-input-wrapper {
  display: flex;
  align-items: center;
  gap: 20rpx;
}

.code-field {
  flex: 1;
  background: #f8f9fa;
  border-radius: 16rpx;
  padding: 26rpx;
  font-size: 28rpx;
  color: #2C3E50;
  border: 2rpx solid transparent;
  transition: all 0.3s ease;
}

.code-field:focus {
  border-color: #667eea;
  background: white;
}

.get-code-btn {
  background: linear-gradient(135deg, #43e97b 0%, #38f9d7 100%);
  color: white;
  border: none;
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
  font-size: 24rpx;
  font-weight: 500;
  min-width: 200rpx;
  transition: all 0.3s ease;
}

.get-code-btn[disabled] {
  opacity: 0.5;
  background: #95A5A6;
}

.get-code-btn:active:not([disabled]) {
  transform: scale(0.95);
}

/* 登录按钮 */
.login-btn {
  background: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
  color: white;
  border: none;
  border-radius: 50rpx;
  padding: 30rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 10rpx;
  box-shadow: 0 12rpx 40rpx rgba(102, 126, 234, 0.4);
  transition: all 0.3s ease;
}

.login-btn:active {
  transform: scale(0.98);
}

.login-btn[disabled] {
  opacity: 0.5;
  background: #95A5A6;
  box-shadow: none;
}

/* 快速登录 */
.quick-login {
  margin-top: 50rpx;
  padding-top: 40rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.quick-title {
  display: block;
  text-align: center;
  font-size: 26rpx;
  color: #95A5A6;
  margin-bottom: 30rpx;
}

.quick-buttons {
  display: flex;
  justify-content: center;
}

.quick-btn {
  border: none;
  border-radius: 50rpx;
  padding: 24rpx 40rpx;
  display: flex;
  align-items: center;
  gap: 12rpx;
  transition: all 0.3s ease;
}

.quick-btn.wechat {
  background: rgba(67, 233, 123, 0.1);
  color: #43e97b;
}

.quick-btn:active {
  transform: scale(0.95);
}

.quick-icon {
  font-size: 32rpx;
}

.quick-text {
  font-size: 26rpx;
  font-weight: 500;
}

/* 游客模式 */
.guest-mode {
  text-align: center;
  margin-top: 40rpx;
}

.guest-text {
  font-size: 24rpx;
  color: #667eea;
  font-weight: 500;
  padding: 10rpx 20rpx;
}

.guest-text:active {
  opacity: 0.7;
}

/* 底部装饰 */
.bottom-decoration {
  text-align: center;
  padding-top: 40rpx;
  border-top: 1rpx solid rgba(0, 0, 0, 0.05);
}

.plant-icon {
  font-size: 48rpx;
  display: block;
  margin-bottom: 16rpx;
}

.plant-text {
  font-size: 22rpx;
  color: #95A5A6;
  font-weight: 300;
  font-style: italic;
}

/* 加载遮罩 */
.loading-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 1000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.loading-content {
  background: white;
  padding: 60rpx 80rpx;
  border-radius: 20rpx;
}

.loading-text {
  font-size: 28rpx;
  color: #2C3E50;
  font-weight: 500;
}

/* 响应式调整 */
@media (max-width: 360px) {
  .login-container {
    margin: 0 30rpx;
    padding: 30rpx;
  }
  
  .app-name {
    font-size: 48rpx;
  }
  
  .welcome {
    font-size: 32rpx;
  }
}